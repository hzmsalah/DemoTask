# SQL Server credentials and connection. Copy this file to .env for local Docker use.
# Use a strong password; avoid $ ' " ; and backslash because Compose interpolates them.
MSSQL_SA_PASSWORD=YourStrong@Password123
MSSQL_DB_NAME=ShaghafDb
MSSQL_PORT=1433

# Application ports
API_PORT=5000
UI_PORT=3000

# Development enables the OpenAPI document and demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# Used only by `npm run dev` (Vite proxy target), not by Docker.
VITE_DEV_API_TARGET=http://localhost:5000
